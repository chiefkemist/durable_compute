{
  "name": "basic-celld-queues",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "basic-celld-jobs" }],
    "consumers": [
      {
        "queue": "basic-celld-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 2,
        "dead_letter_queue": "basic-celld-jobs-dead-letter"
      },
      { "queue": "basic-celld-jobs-dead-letter" }
    ]
  }
}
