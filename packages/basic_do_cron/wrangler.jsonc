{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "basic-do-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [{ "name": "TICKS", "class_name": "Ticker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ticker"] }]
}
