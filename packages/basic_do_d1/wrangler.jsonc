{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "basic-do-d1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basic-do-d1",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
