{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "basic-do-workflows",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workflows": [
    {
      "binding": "REPORTS",
      "name": "basic-do-report",
      "class_name": "ReportBuilder"
    }
  ]
}
